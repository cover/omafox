#!/bin/bash

set -euo pipefail

readonly PROGRAM_NAME="omafox"
readonly VERSION="1.1.0"
readonly PROTOCOL="omafox"
readonly PROTOCOL_VERSION=1
readonly ACTION="theme-set"
readonly MAX_THEME_NAME_LENGTH=100
readonly QUATTRO_THEME_DIR="${OMAFOX_THEME_DIR:-$HOME/.local/state/omarchy/current/theme}"
readonly QUATTRO_THEME_NAME_FILE="${OMAFOX_THEME_NAME_FILE:-$HOME/.local/state/omarchy/current/theme.name}"
readonly HOOK_PATH="$HOME/.config/omarchy/hooks/theme-set.d/omafox"
readonly STATE_DIR="$HOME/.local/state/omafox"
readonly STATE_FILE="$STATE_DIR/theme.json"
readonly NATIVE_HOST_NAME="org.omarchy.omafox"
readonly NATIVE_HOST_PATH="${OMAFOX_NATIVE_HOST_PATH:-/usr/lib/omafox/omafox-native-host}"
readonly NATIVE_MANIFEST_PATH="${OMAFOX_NATIVE_MANIFEST_PATH:-/usr/lib/mozilla/native-messaging-hosts/$NATIVE_HOST_NAME.json}"
readonly HOOK_SOURCE="${OMAFOX_HOOK_SOURCE:-/usr/share/omafox/hooks/omafox}"
readonly ZEN_ROOT="${OMAFOX_ZEN_ROOT:-$HOME/.config/zen}"
readonly ZEN_PROFILES_FILE="${OMAFOX_ZEN_PROFILES_FILE:-$ZEN_ROOT/profiles.ini}"
readonly ZEN_BRIDGE_SOURCE="${OMAFOX_ZEN_BRIDGE_SOURCE:-/usr/share/omafox/zen/omafox.css}"
readonly ZEN_BRIDGE_MARKER='/* OMAFOX ZEN BRIDGE MANAGED FILE */'
readonly ZEN_CSS_BEGIN='/* BEGIN OMAFOX ZEN BRIDGE */'
readonly ZEN_CSS_END='/* END OMAFOX ZEN BRIDGE */'
readonly ZEN_PREFS_BEGIN='// BEGIN OMAFOX ZEN BRIDGE'
readonly ZEN_PREFS_END='// END OMAFOX ZEN BRIDGE'
ZEN_CONFIGURED_COUNT=0
readonly -a PALETTE_KEYS=(
  mode
  accent selection muted
  background dark_background darker_background lighter_background
  foreground dark_foreground light_foreground bright_foreground
  red yellow orange green cyan blue magenta brown
  bright_red bright_yellow bright_green bright_cyan bright_blue bright_magenta
)

usage() {
  cat <<'EOF'
Usage: omafox <command>

Keep Firefox and Zen Browser in sync with the current Omarchy Quattro palette.

Commands:
  sync     Queue the current palette for connected browsers
  payload  Print the current JSON protocol message
  status   Show the current theme and integration state
  setup    Enable the packaged Omafox integration for this user
  remove   Remove this user's Omafox hook and theme state
  version  Print the Omafox version
  help     Show this help
EOF
}

fail() {
  echo "$PROGRAM_NAME: $*" >&2
  exit 1
}

trim() {
  local value=$1
  value=${value#"${value%%[![:space:]]*}"}
  value=${value%"${value##*[![:space:]]}"}
  printf '%s' "$value"
}

normalize_color() {
  local value=${1:-}

  case $value in
    \#[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F])
      printf '%s' "$value"
      ;;
    0x[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F])
      printf '#%s' "${value#0x}"
      ;;
    \#[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F])
      printf '#%s%s%s%s%s%s' \
        "${value:1:1}" "${value:1:1}" \
        "${value:2:1}" "${value:2:1}" \
        "${value:3:1}" "${value:3:1}"
      ;;
    *)
      return 1
      ;;
  esac
}

is_color() {
  [[ ${1:-} =~ ^#[0-9a-fA-F]{6}$ ]]
}

mix_colors() {
  local first=${1#\#} second=${2#\#} second_percent=$3
  local first_percent=$((100 - second_percent))
  local first_red first_green first_blue second_red second_green second_blue

  first_red=$((16#${first:0:2}))
  first_green=$((16#${first:2:2}))
  first_blue=$((16#${first:4:2}))
  second_red=$((16#${second:0:2}))
  second_green=$((16#${second:2:2}))
  second_blue=$((16#${second:4:2}))

  printf '#%02X%02X%02X' \
    "$(((first_red * first_percent + second_red * second_percent) / 100))" \
    "$(((first_green * first_percent + second_green * second_percent) / 100))" \
    "$(((first_blue * first_percent + second_blue * second_percent) / 100))"
}

infer_mode() {
  local color=${1#\#} red green blue brightness
  red=$((16#${color:0:2}))
  green=$((16#${color:2:2}))
  blue=$((16#${color:4:2}))
  brightness=$((299 * red + 587 * green + 114 * blue))

  if (( brightness >= 145000 )); then
    printf 'light'
  else
    printf 'dark'
  fi
}

set_color_from() {
  local target=$1 candidate value
  shift

  is_color "${OMAFOX_PALETTE[$target]-}" && return 0
  for candidate in "$@"; do
    if is_color "$candidate"; then
      OMAFOX_PALETTE["$target"]=$candidate
      return 0
    fi
    value=${OMAFOX_PALETTE[$candidate]-}
    if is_color "$value"; then
      OMAFOX_PALETTE["$target"]=$value
      return 0
    fi
  done

  return 1
}

derive_bright_color() {
  local target=$1 source=$2
  is_color "${OMAFOX_PALETTE[$target]-}" && return 0

  if [[ ${OMAFOX_PALETTE[mode]} == "light" ]]; then
    OMAFOX_PALETTE["$target"]=$(mix_colors "${OMAFOX_PALETTE[$source]}" "#000000" 8)
  else
    OMAFOX_PALETTE["$target"]=$(mix_colors "${OMAFOX_PALETTE[$source]}" "#FFFFFF" 18)
  fi
}

fill_palette_fallbacks() {
  local key normalized background_sample=""
  local default_background default_foreground default_accent
  local default_red default_yellow default_green default_cyan default_blue default_magenta

  # Normalize common custom-theme forms and discard malformed entries so they
  # can follow the same fallback path as omitted values.
  for key in "${PALETTE_KEYS[@]:1}"; do
    if normalized=$(normalize_color "${OMAFOX_PALETTE[$key]-}"); then
      OMAFOX_PALETTE["$key"]=$normalized
    else
      unset "OMAFOX_PALETTE[$key]"
    fi
  done

  if [[ ${OMAFOX_PALETTE[mode]-} != "dark" && ${OMAFOX_PALETTE[mode]-} != "light" ]]; then
    for key in background dark_background darker_background lighter_background; do
      if is_color "${OMAFOX_PALETTE[$key]-}"; then
        background_sample=${OMAFOX_PALETTE[$key]}
        break
      fi
    done
    OMAFOX_PALETTE[mode]=$(if [[ -n $background_sample ]]; then infer_mode "$background_sample"; else printf 'dark'; fi)
  fi

  if [[ ${OMAFOX_PALETTE[mode]} == "light" ]]; then
    default_background="#FFFFFF"
    default_foreground="#181818"
    default_accent="#1565C0"
    default_red="#C62828"
    default_yellow="#8A6D00"
    default_green="#2E7D32"
    default_cyan="#007C91"
    default_blue="#1565C0"
    default_magenta="#8E24AA"
  else
    default_background="#1E1E2E"
    default_foreground="#CDD6F4"
    default_accent="#89B4FA"
    default_red="#F38BA8"
    default_yellow="#F9E2AF"
    default_green="#A6E3A1"
    default_cyan="#94E2D5"
    default_blue="#89B4FA"
    default_magenta="#CBA6F7"
  fi

  set_color_from background dark_background darker_background lighter_background "$default_background"
  set_color_from foreground light_foreground bright_foreground dark_foreground "$default_foreground"
  set_color_from accent blue bright_blue cyan bright_cyan magenta bright_magenta "$default_accent"

  if ! is_color "${OMAFOX_PALETTE[selection]-}"; then
    OMAFOX_PALETTE[selection]=$(mix_colors "${OMAFOX_PALETTE[background]}" "${OMAFOX_PALETTE[accent]}" 25)
  fi
  if ! is_color "${OMAFOX_PALETTE[muted]-}"; then
    OMAFOX_PALETTE[muted]=$(mix_colors "${OMAFOX_PALETTE[foreground]}" "${OMAFOX_PALETTE[background]}" 55)
  fi

  if ! is_color "${OMAFOX_PALETTE[dark_background]-}"; then
    OMAFOX_PALETTE[dark_background]=$(mix_colors "${OMAFOX_PALETTE[background]}" "#000000" 4)
  fi
  if ! is_color "${OMAFOX_PALETTE[darker_background]-}"; then
    OMAFOX_PALETTE[darker_background]=$(mix_colors "${OMAFOX_PALETTE[background]}" "#000000" 10)
  fi
  if ! is_color "${OMAFOX_PALETTE[lighter_background]-}"; then
    if [[ ${OMAFOX_PALETTE[mode]} == "light" ]]; then
      OMAFOX_PALETTE[lighter_background]=$(mix_colors "${OMAFOX_PALETTE[background]}" "#000000" 10)
    else
      OMAFOX_PALETTE[lighter_background]=$(mix_colors "${OMAFOX_PALETTE[background]}" "#FFFFFF" 10)
    fi
  fi

  set_color_from dark_foreground muted foreground
  set_color_from light_foreground foreground
  if ! is_color "${OMAFOX_PALETTE[bright_foreground]-}"; then
    if [[ ${OMAFOX_PALETTE[mode]} == "light" ]]; then
      OMAFOX_PALETTE[bright_foreground]=${OMAFOX_PALETTE[foreground]}
    else
      OMAFOX_PALETTE[bright_foreground]=$(mix_colors "${OMAFOX_PALETTE[foreground]}" "#FFFFFF" 12)
    fi
  fi

  set_color_from red bright_red "$default_red"
  set_color_from yellow bright_yellow "$default_yellow"
  set_color_from green bright_green "$default_green"
  set_color_from cyan bright_cyan "$default_cyan"
  set_color_from blue bright_blue accent "$default_blue"
  set_color_from magenta bright_magenta "$default_magenta"
  set_color_from orange yellow accent "#B56A32"
  set_color_from brown muted "#795548"

  derive_bright_color bright_red red
  derive_bright_color bright_yellow yellow
  derive_bright_color bright_green green
  derive_bright_color bright_cyan cyan
  derive_bright_color bright_blue blue
  derive_bright_color bright_magenta magenta
}

require_quattro() {
  local version major

  command -v omarchy >/dev/null 2>&1 || fail "Omarchy is not installed"
  version=$(omarchy version 2>/dev/null || true)
  major=${version%%.*}
  if [[ ! $major =~ ^[0-9]+$ ]] || (( major < 4 )); then
    fail "Omarchy Quattro (version 4) or newer is required"
  fi
  [[ -f "$QUATTRO_THEME_DIR/colors.toml" ]] || \
    fail "Quattro palette not found: $QUATTRO_THEME_DIR/colors.toml"
}

read_palette() {
  local line key value
  declare -gA OMAFOX_PALETTE=()

  while IFS= read -r line || [[ -n $line ]]; do
    [[ $line == *"="* ]] || continue
    key=$(trim "${line%%=*}")
    value=$(trim "${line#*=}")
    [[ $key =~ ^[a-z_]+$ ]] || continue

    if [[ $value == \"* ]]; then
      value=${value#\"}
      value=${value%%\"*}
    elif [[ $value == \'* ]]; then
      value=${value#\'}
      value=${value%%\'*}
    else
      value=${value%%[[:space:]#]*}
    fi
    OMAFOX_PALETTE["$key"]=$value
  done < "$QUATTRO_THEME_DIR/colors.toml"

  fill_palette_fallbacks

  [[ ${OMAFOX_PALETTE[mode]-} == "dark" || ${OMAFOX_PALETTE[mode]-} == "light" ]] || \
    fail "colors.toml has an invalid or missing mode"

  for key in "${PALETTE_KEYS[@]:1}"; do
    value=${OMAFOX_PALETTE[$key]-}
    [[ $value =~ ^#[0-9a-fA-F]{6}$ ]] || \
      fail "colors.toml has an invalid or missing $key color"
  done
}

json_escape() {
  local LC_ALL=C
  local input=$1 output="" character escaped index

  for ((index = 0; index < ${#input}; index++)); do
    character=${input:index:1}
    case $character in
      '"') output+='\"' ;;
      "\\") output+="\\\\" ;;
      [[:cntrl:]])
        printf -v escaped '\\u%04X' "'$character"
        output+=$escaped
        ;;
      *) output+=$character ;;
    esac
  done

  printf '%s' "$output"
}

current_theme_name() {
  local name=""

  if [[ -f $QUATTRO_THEME_NAME_FILE ]]; then
    IFS= read -r name < "$QUATTRO_THEME_NAME_FILE" || true
  fi

  [[ -n $name ]] || name="omarchy"
  (( ${#name} <= MAX_THEME_NAME_LENGTH )) || \
    fail "theme name exceeds $MAX_THEME_NAME_LENGTH characters"
  printf '%s' "$name"
}

build_payload() {
  local theme_name key value separator=""

  require_quattro
  read_palette
  theme_name=$(current_theme_name)

  printf '{"protocol":"%s","version":%d,"action":"%s","theme":"%s","palette":{' \
    "$PROTOCOL" "$PROTOCOL_VERSION" "$ACTION" "$(json_escape "$theme_name")"

  for key in "${PALETTE_KEYS[@]}"; do
    value=${OMAFOX_PALETTE[$key]}
    printf '%s"%s":"%s"' "$separator" "$key" "$(json_escape "$value")"
    separator=,
  done

  printf '}}\n'
}

sync_theme() {
  local payload
  payload=$(build_payload)
  store_theme_payload "$payload"
}

store_theme_payload() {
  local payload=$1 temporary_file

  install -d -m 700 "$STATE_DIR"
  temporary_file=$(mktemp "$STATE_DIR/.theme.json.XXXXXX")
  if ! chmod 600 "$temporary_file" \
      || ! printf '%s\n' "$payload" > "$temporary_file" \
      || ! mv -f "$temporary_file" "$STATE_FILE"; then
    rm -f "$temporary_file"
    fail "could not write theme state: $STATE_FILE"
  fi
}

emit_zen_profile() {
  local path=$1 is_relative=$2

  [[ -n $path ]] || return 0
  if [[ $is_relative == 1 ]]; then
    printf '%s/%s\n' "$ZEN_ROOT" "$path"
  elif [[ $is_relative == 0 ]]; then
    printf '%s\n' "$path"
  fi
}

list_zen_profiles() {
  local line section="" path="" is_relative=1 key value

  [[ -f $ZEN_PROFILES_FILE ]] || return 0
  while IFS= read -r line || [[ -n $line ]]; do
    line=${line%$'\r'}
    if [[ $line == \[*\] ]]; then
      if [[ $section == Profile* ]]; then
        emit_zen_profile "$path" "$is_relative"
      fi
      section=${line#\[}
      section=${section%\]}
      path=""
      is_relative=1
      continue
    fi

    [[ $section == Profile* && $line == *"="* ]] || continue
    key=$(trim "${line%%=*}")
    value=$(trim "${line#*=}")
    case $key in
      Path) path=$value ;;
      IsRelative) is_relative=$value ;;
    esac
  done < "$ZEN_PROFILES_FILE"

  if [[ $section == Profile* ]]; then
    emit_zen_profile "$path" "$is_relative"
  fi
}

list_unique_zen_profiles() {
  local profile
  local -a profiles=()
  local -A seen=()

  mapfile -t profiles < <(list_zen_profiles)
  for profile in "${profiles[@]}"; do
    [[ -n $profile && -z ${seen[$profile]+x} ]] || continue
    seen["$profile"]=1
    printf '%s\n' "$profile"
  done
}

zen_bridge_owned() {
  local target=$1 first_line=""

  [[ -f $target && ! -L $target ]] || return 1
  IFS= read -r first_line < "$target" || true
  [[ $first_line == "$ZEN_BRIDGE_MARKER" ]]
}

validate_zen_bridge() {
  local target=$1

  [[ ! -L $target ]] || fail "refusing to replace symlinked Zen bridge: $target"
  [[ ! -e $target || -f $target ]] || fail "Zen bridge path is not a regular file: $target"
  [[ ! -f $target ]] || zen_bridge_owned "$target" || fail "refusing to modify unmanaged Zen bridge: $target"
}

validate_managed_block() {
  local target=$1 begin=$2 end=$3 begin_count end_count begin_match end_match

  [[ ! -L $target ]] || fail "refusing to replace symlinked Zen profile file: $target"
  [[ ! -e $target || -f $target ]] || fail "Zen profile path is not a regular file: $target"
  [[ -f $target ]] || return 0

  begin_count=$(grep -Fxc "$begin" "$target" || true)
  end_count=$(grep -Fxc "$end" "$target" || true)
  if (( begin_count != end_count || begin_count > 1 )); then
    fail "malformed Omafox markers in Zen profile file: $target"
  fi
  if (( begin_count == 1 )); then
    begin_match=$(grep -Fnx "$begin" "$target")
    end_match=$(grep -Fnx "$end" "$target")
    if (( ${begin_match%%:*} >= ${end_match%%:*} )); then
      fail "malformed Omafox markers in Zen profile file: $target"
    fi
  fi
}

emit_without_managed_block() {
  local input=$1 begin=$2 end=$3

  [[ -f $input ]] || return 0

  awk -v begin="$begin" -v end="$end" '
    $0 == begin { managed = 1; next }
    $0 == end { managed = 0; next }
    !managed { print }
  ' "$input"
}

atomic_replace_profile_file() {
  local target=$1 temporary_file=$2 mode=600

  if [[ -f $target ]]; then
    mode=$(stat -c '%a' "$target")
  fi
  chmod "$mode" "$temporary_file"
  mv -f "$temporary_file" "$target"
}

install_zen_user_chrome() {
  local target=$1 temporary_file

  validate_managed_block "$target" "$ZEN_CSS_BEGIN" "$ZEN_CSS_END"
  temporary_file=$(mktemp "$(dirname "$target")/.userChrome.css.XXXXXX")

  {
    printf '%s\n' "$ZEN_CSS_BEGIN"
    printf '%s\n' '@import url("omafox.css");'
    printf '\n'
    printf '%s\n' "$ZEN_CSS_END"
    emit_without_managed_block "$target" "$ZEN_CSS_BEGIN" "$ZEN_CSS_END"
  } > "$temporary_file"

  atomic_replace_profile_file "$target" "$temporary_file"
}

install_zen_user_prefs() {
  local target=$1 temporary_file

  validate_managed_block "$target" "$ZEN_PREFS_BEGIN" "$ZEN_PREFS_END"
  temporary_file=$(mktemp "$(dirname "$target")/.user.js.XXXXXX")

  {
    emit_without_managed_block "$target" "$ZEN_PREFS_BEGIN" "$ZEN_PREFS_END"
    printf '%s\n' "$ZEN_PREFS_BEGIN"
    printf '%s\n' 'user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);'
    printf '%s\n' 'user_pref("zen.theme.disable-lightweight", false);'
    printf '%s\n' "$ZEN_PREFS_END"
  } > "$temporary_file"

  atomic_replace_profile_file "$target" "$temporary_file"
}

configure_zen_profile() {
  local profile=$1 chrome_dir bridge_target user_chrome user_prefs

  chrome_dir="$profile/chrome"

  if [[ -e $chrome_dir && ! -d $chrome_dir ]]; then
    fail "Zen chrome path is not a directory: $chrome_dir"
  elif [[ ! -d $chrome_dir ]]; then
    install -d -m 700 "$chrome_dir"
  fi
  bridge_target="$chrome_dir/omafox.css"
  user_chrome="$chrome_dir/userChrome.css"
  user_prefs="$profile/user.js"

  validate_zen_bridge "$bridge_target"
  validate_managed_block "$user_chrome" "$ZEN_CSS_BEGIN" "$ZEN_CSS_END"
  validate_managed_block "$user_prefs" "$ZEN_PREFS_BEGIN" "$ZEN_PREFS_END"
  install -m 600 "$ZEN_BRIDGE_SOURCE" "$bridge_target"
  install_zen_user_chrome "$user_chrome"
  install_zen_user_prefs "$user_prefs"
  printf 'Configured Zen profile: %s\n' "$profile"
}

validate_zen_profile() {
  local profile=$1 chrome_dir bridge_target

  chrome_dir="$profile/chrome"
  bridge_target="$chrome_dir/omafox.css"
  [[ ! -e $chrome_dir || -d $chrome_dir ]] || \
    fail "Zen chrome path is not a directory: $chrome_dir"
  validate_zen_bridge "$bridge_target"
  validate_managed_block "$chrome_dir/userChrome.css" "$ZEN_CSS_BEGIN" "$ZEN_CSS_END"
  validate_managed_block "$profile/user.js" "$ZEN_PREFS_BEGIN" "$ZEN_PREFS_END"
}

setup_zen_profiles() {
  local profile
  local -a profiles=() existing_profiles=()

  ZEN_CONFIGURED_COUNT=0
  [[ -f $ZEN_PROFILES_FILE ]] || return 0
  mapfile -t profiles < <(list_unique_zen_profiles)
  for profile in "${profiles[@]}"; do
    if [[ ! -d $profile ]]; then
      printf 'Skipped missing Zen profile: %s\n' "$profile" >&2
      continue
    fi
    existing_profiles+=("$profile")
  done

  (( ${#existing_profiles[@]} > 0 )) || return 0
  zen_bridge_owned "$ZEN_BRIDGE_SOURCE" || \
    fail "packaged Zen bridge is missing or invalid: $ZEN_BRIDGE_SOURCE"
  for profile in "${existing_profiles[@]}"; do
    validate_zen_profile "$profile"
  done
  for profile in "${existing_profiles[@]}"; do
    configure_zen_profile "$profile"
    ((ZEN_CONFIGURED_COUNT += 1))
  done
}

managed_block_present() {
  local target=$1 begin=$2 end=$3
  [[ -f $target ]] \
    && grep -Fqx "$begin" "$target" \
    && grep -Fqx "$end" "$target"
}

managed_marker_present() {
  local target=$1 begin=$2 end=$3
  [[ -f $target ]] \
    && { grep -Fqx "$begin" "$target" || grep -Fqx "$end" "$target"; }
}

zen_profile_status() {
  local profile=$1 bridge user_chrome user_prefs

  bridge="$profile/chrome/omafox.css"
  user_chrome="$profile/chrome/userChrome.css"
  user_prefs="$profile/user.js"

  if [[ -e $bridge || -L $bridge ]] && ! zen_bridge_owned "$bridge"; then
    printf 'conflict'
  elif zen_bridge_owned "$bridge" \
      && managed_block_present "$user_chrome" "$ZEN_CSS_BEGIN" "$ZEN_CSS_END" \
      && managed_block_present "$user_prefs" "$ZEN_PREFS_BEGIN" "$ZEN_PREFS_END"; then
    if [[ -f $ZEN_BRIDGE_SOURCE ]] && ! cmp -s "$ZEN_BRIDGE_SOURCE" "$bridge"; then
      printf 'outdated'
    else
      printf 'configured'
    fi
  elif [[ -e $bridge ]] \
      || managed_marker_present "$user_chrome" "$ZEN_CSS_BEGIN" "$ZEN_CSS_END" \
      || managed_marker_present "$user_prefs" "$ZEN_PREFS_BEGIN" "$ZEN_PREFS_END"; then
    printf 'incomplete'
  else
    printf 'not configured'
  fi
}

show_zen_status() {
  local profile found=0
  local -a profiles=()

  if [[ ! -f $ZEN_PROFILES_FILE ]]; then
    printf 'Zen profiles: not detected (%s)\n' "$ZEN_PROFILES_FILE"
    return 0
  fi

  mapfile -t profiles < <(list_unique_zen_profiles)
  for profile in "${profiles[@]}"; do
    found=1
    if [[ -d $profile ]]; then
      printf 'Zen profile: %s (%s)\n' "$profile" "$(zen_profile_status "$profile")"
    else
      printf 'Zen profile: %s (missing)\n' "$profile"
    fi
  done
  (( found == 1 )) || printf 'Zen profiles: none listed in %s\n' "$ZEN_PROFILES_FILE"
}

remove_managed_profile_block() {
  local target=$1 begin=$2 end=$3 temporary_file

  [[ -e $target || -L $target ]] || return 0
  validate_managed_block "$target" "$begin" "$end"
  managed_block_present "$target" "$begin" "$end" || return 0
  temporary_file=$(mktemp "$(dirname "$target")/.$(basename "$target").XXXXXX")
  emit_without_managed_block "$target" "$begin" "$end" > "$temporary_file"
  if [[ -s $temporary_file ]]; then
    atomic_replace_profile_file "$target" "$temporary_file"
  else
    rm -f "$target" "$temporary_file"
  fi
}

remove_zen_profile() {
  local profile=$1 bridge configured=0

  bridge="$profile/chrome/omafox.css"
  validate_zen_bridge "$bridge"
  if [[ -e $bridge ]] \
      || managed_marker_present "$profile/chrome/userChrome.css" "$ZEN_CSS_BEGIN" "$ZEN_CSS_END" \
      || managed_marker_present "$profile/user.js" "$ZEN_PREFS_BEGIN" "$ZEN_PREFS_END"; then
    configured=1
  fi

  remove_managed_profile_block \
    "$profile/chrome/userChrome.css" "$ZEN_CSS_BEGIN" "$ZEN_CSS_END"
  remove_managed_profile_block \
    "$profile/user.js" "$ZEN_PREFS_BEGIN" "$ZEN_PREFS_END"
  if [[ -f $bridge ]]; then
    rm -f "$bridge"
  fi
  if (( configured == 1 )); then
    printf 'Removed Zen profile bridge: %s\n' "$profile"
  fi
}

remove_zen_profiles() {
  local profile
  local -a profiles=()

  [[ -f $ZEN_PROFILES_FILE ]] || return 0
  mapfile -t profiles < <(list_unique_zen_profiles)
  for profile in "${profiles[@]}"; do
    [[ -d $profile ]] || continue
    validate_zen_profile "$profile"
  done
  for profile in "${profiles[@]}"; do
    [[ -d $profile ]] || continue
    remove_zen_profile "$profile"
  done
}

show_status() {
  local theme_name="unknown"
  if [[ -f $QUATTRO_THEME_NAME_FILE ]]; then
    IFS= read -r theme_name < "$QUATTRO_THEME_NAME_FILE" || true
  fi

  printf 'Omafox version: %s\n' "$VERSION"
  printf 'Theme: %s\n' "$theme_name"
  printf 'Palette: %s/colors.toml\n' "$QUATTRO_THEME_DIR"
  printf 'Hook: %s\n' "$HOOK_PATH"
  printf 'Theme state: %s (%s)\n' "$STATE_FILE" "$([[ -f $STATE_FILE ]] && echo ready || echo missing)"
  printf 'Native host: %s (%s)\n' "$NATIVE_HOST_PATH" "$([[ -x $NATIVE_HOST_PATH ]] && echo installed || echo missing)"
  printf 'Native manifest: %s (%s)\n' "$NATIVE_MANIFEST_PATH" "$([[ -f $NATIVE_MANIFEST_PATH ]] && echo installed || echo missing)"
  show_zen_status
}

setup_omafox() {
  require_quattro
  [[ -x $NATIVE_HOST_PATH ]] || fail "packaged native host not found: $NATIVE_HOST_PATH"
  [[ -f $NATIVE_MANIFEST_PATH ]] || fail "packaged native manifest not found: $NATIVE_MANIFEST_PATH"
  [[ -x $HOOK_SOURCE ]] || fail "packaged Omarchy hook not found: $HOOK_SOURCE"

  omarchy hook install theme-set "$HOOK_SOURCE"
  printf 'Enabled user hook: %s\n' "$HOOK_PATH"
  printf 'Using packaged native host: %s\n' "$NATIVE_HOST_PATH"
  setup_zen_profiles
  sync_theme
  echo "Queued the current Omarchy palette for connected browsers."
  if (( ZEN_CONFIGURED_COUNT > 0 )); then
    echo "Restart Zen Browser once to load the Omafox bridge."
  fi
}

remove_omafox() {
  remove_zen_profiles

  if [[ -e $HOOK_PATH || -L $HOOK_PATH ]]; then
    rm -f "$HOOK_PATH"
    printf 'Removed hook: %s\n' "$HOOK_PATH"
  fi

  if [[ -e $STATE_FILE || -L $STATE_FILE ]]; then
    rm -f "$STATE_FILE"
    printf 'Removed theme state: %s\n' "$STATE_FILE"
  fi
  rmdir "$STATE_DIR" 2>/dev/null || true
  echo "System files are managed by pacman; remove them with: sudo pacman -Rns omafox"
}

main() {
  local command=${1:-help}
  [[ $# -eq 0 ]] || shift

  case $command in
    sync|payload|status|setup|remove|version|-V|--version|help|-h|--help)
      (( $# == 0 )) || fail "command '$command' does not accept arguments"
      ;;
  esac

  case $command in
    sync) sync_theme ;;
    payload) build_payload ;;
    status) show_status ;;
    setup) setup_omafox ;;
    remove) remove_omafox ;;
    version|-V|--version) printf '%s\n' "$VERSION" ;;
    help|-h|--help) usage ;;
    -*) fail "unknown option: $command" ;;
    *) fail "unknown command: $command" ;;
  esac
}

main "$@"
